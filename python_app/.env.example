# Copy to .env and fill in. Never commit the real .env file.

# Required to make any LLM call. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
AVINYA_MODEL=claude-sonnet-5
AVINYA_MAX_TOKENS=3000

# Where per-student profile/notes/history JSON files are written.
AVINYA_DATA_DIR=./student_data
